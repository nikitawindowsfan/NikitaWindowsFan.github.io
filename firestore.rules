rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'nikita@nikitawindowsfan.local';
    }

    // Публичный контент сайта читают все, менять его может только администратор.
    match /public/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Клиенты могут читать последние сообщения, но отправка разрешена только
    // через Cloud Function sendChatMessage, где выполняются фильтры и баны.
    match /chatMessages/{messageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Состояние банов доступно только серверной функции с Admin SDK.
    match /chatModeration/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
